# Preview route. Included by the existing production-sites.caddy route.
# Caddy 2.6 uses `basicauth`; credentials live outside the checkout.
pops.elis.space {
    encode zstd gzip
    header {
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-Robots-Tag "noindex, nofollow, noarchive"
        Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; frame-src https://airtable.com; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'"
    }
    route {
        # Preview opens directly on rentals; the consulting page remains /index.html.
        redir / /apply/ 302
        @private path /admin /admin/* /api/admin /api/admin/*
        basicauth @private {
            import /srv/platform/migration-managed/pops-private/admin-users.caddy
        }
        @dotfiles path_regexp dotfiles (^|/)\.
        respond @dotfiles 404
        handle /api/* {
            reverse_proxy unix//run/platform-pops/visibility.sock
        }
        handle {
            root * /srv/platform/migration-managed/pops-repo/public
            file_server
        }
    }
}
